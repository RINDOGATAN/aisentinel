{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/sync-catalog",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/pilot-reminders",
      "schedule": "15 7 * * *"
    }
  ],
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in auto-upgrade/*) exit 0;; *) exit 1;; esac"
}
